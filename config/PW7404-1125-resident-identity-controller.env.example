# Controller-only environment. Do not load this file into the Next.js process.
# The IPC key must be a controller-owned mode-0600 copy, not the app-owned copy.
SPACEBOT_IDENTITY_CONTROLLER_DATABASE_URL_FILE=/etc/spacebot/secrets/resident-identity-controller-database.url
SPACEBOT_IDENTITY_CONTROLLER_DATABASE_CA_PATH=/etc/spacebot/certs/database-ca.pem
SPACEBOT_IDENTITY_CONTROLLER_EXPECTED_CA_SHA256=
SPACEBOT_IDENTITY_CONTROLLER_EXPECTED_HOSTNAME=
SPACEBOT_IDENTITY_CONTROLLER_EXPECTED_DATABASE=
SPACEBOT_IDENTITY_CONTROLLER_EXPECTED_USER=spacebot_identity_controller
SPACEBOT_IDENTITY_CONTROLLER_EXPECTED_DATABASE_OID=
SPACEBOT_IDENTITY_CONTROLLER_EXPECTED_ADDRESS=
SPACEBOT_IDENTITY_CONTROLLER_EXPECTED_PORT=
SPACEBOT_IDENTITY_CONTROLLER_SIGNING_SECRET_FILE=/etc/spacebot/secrets/resident-identity-controller-ipc.key
