*.tmp
*.temp
tmp/
temp/

# Backup files (agent audit artifacts)
*.bak
*.bak.*
*.backup
*.old

# PM2
.pm2/
pm2.log

# Machine keys (contain secrets)
.machine_keys.json

# Test coverage
coverage/
.nyc_output/

# Build artifacts
*.pid
*.seed
*.pid.lock

# Lock files (keep package-lock.json intact, ignore others)
